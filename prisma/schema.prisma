// Greenpoly Prisma schema (v1)
// Generator outputs to src/generated/prisma so we import via "@/generated/prisma".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ============================================================
// Inquiry — leads from the contact form
// ============================================================
model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  phone       String?
  country     String?
  port        String?
  product     String?
  volume      String?
  incoterms   String?
  message     String?
  status      String   @default("NEW") // NEW | CONTACTED | QUOTED | NEGOTIATING | WON | LOST
  notes       String?
  sessionId   String?
  ipAddress   String?
  userAgent   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([sessionId])
}

// ============================================================
// QuoteDraft / SampleConfirmation — operator-owned sales records
// inquiryId points to the authoritative inquiry source. It is intentionally
// not a foreign key because inquiries may be served by the Go BFF.
// ============================================================
model QuoteDraft {
  id                    String    @id @default(cuid())
  inquiryId             String
  status                String    @default("DRAFT")
  product               String?
  grade                 String?
  quantityMt            Float?
  quantityUnit          String?
  currency              String?
  incoterm              String?
  originPort            String?
  destinationPort       String?
  supplierCostCnyPerMt  Float?
  inlandAndPortCny      Float?
  documentsCny          Float?
  exchangeRateCnyPerUsd Float?
  targetMarginPercent   Float?
  oceanFreightUsd       Float?
  insurancePercent      Float?
  paymentTerms          String?
  packaging             String?
  leadTime              String?
  validUntil            DateTime?
  followUpAt            DateTime?
  sentAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([inquiryId])
  @@index([status])
  @@index([followUpAt])
}

model SampleConfirmation {
  id                     String    @id @default(cuid())
  inquiryId              String
  previousVersionId      String?
  version                Int
  status                 String    @default("NEEDS_INFORMATION")
  product                String?
  grade                  String?
  application            String?
  appearance             String?
  technicalRequirements  String?
  quantity               Float?
  quantityUnit           String?
  packaging              String?
  acceptanceCriteria     String?
  targetConfirmationDate DateTime?
  customerConfirmedAt    DateTime?
  handedToFactoryAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([inquiryId, version])
  @@index([inquiryId])
  @@index([status])
  @@index([targetConfirmationDate])
}

// ============================================================
// MvpProspect — operator-owned buyer research for product validation
// This is deliberately separate from Inquiry: prospects are researched by the
// operator, while inquiries are submitted by buyers through the public site.
// ============================================================
model MvpProspect {
  id                   String   @id @default(cuid())
  company              String
  contactName          String?
  contactEmail         String?
  contactUrl           String?
  country              String?
  sourceChannel        String
  shopUrl              String?
  sellsSandingDiscs    Boolean  @default(false)
  sellsToolStorage     Boolean  @default(false)
  evidence             String?
  stage                String   @default("RESEARCH")
  score                Int      @default(0)
  scoreReasons         String?
  targetPriceUsd       Float?
  estimatedMonthlySets Int?
  nextAction           String?
  nextActionAt         DateTime?
  lastContactedAt      DateTime?
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([stage])
  @@index([score])
  @@index([nextActionAt])
  @@index([updatedAt])
}

// ============================================================
// Event — tracking events from the front-end SDK
// ============================================================
model Event {
  id         String  @id @default(cuid())
  eventName  String // page_view | dwell | scroll_depth | cta_click | whatsapp_click | sample_request | form_submit | outbound_click
  page       String
  sessionId  String
  properties String? // JSON-encoded extra props (button id, scroll %, dwell ms, etc.)

  country     String?
  city        String?
  userAgent   String?
  ipAddress   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  locale      String?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventName])
  @@index([page])
  @@index([createdAt])
  @@index([country])
}

// ============================================================
// Session — per-visitor aggregate (one per browser session)
// ============================================================
model Session {
  id           String   @id // sessionId from client (nanoid)
  firstSeen    DateTime @default(now())
  lastSeen     DateTime @updatedAt
  pageViews    Int      @default(0)
  totalDwellMs Int      @default(0)

  ipAddress   String?
  country     String?
  countryCode String?
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  isp         String?
  timezone    String?
  userAgent   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  locale      String?

  inquired Boolean @default(false)

  @@index([country])
  @@index([utmSource])
  @@index([firstSeen])
  @@index([ipAddress])
}

// ============================================================
// Product — catalog (translations inline for v1)
// ============================================================
model Product {
  id       String @id @default(cuid())
  sku      String @unique
  slug     String @unique
  category String // HDPE | PP | PET

  nameEn String
  nameZh String?
  nameRu String?
  nameEs String?

  descEn String?
  descZh String?
  descRu String?
  descEs String?

  color       String?
  mfi         String?
  density     String?
  processType String?
  application String?
  priceFrom   Float?

  imageUrl   String?
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([slug])
}

// ============================================================
// AdminUser — admin dashboard login
// ============================================================
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}
