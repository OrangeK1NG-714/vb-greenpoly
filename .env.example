# ========================================
# GreenPoly — environment variables
# Copy this to .env and fill in values
# ========================================

# Database — SQLite file. dev.db for local, prod.db on the VPS.
# On a single VPS instance SQLite is plenty; no Postgres/Supabase needed.
DATABASE_URL="file:./dev.db"
# Production (on the Singapore VPS):
# DATABASE_URL="file:./prod.db"

# Public site URL — used in sitemap, llms.txt, hreflang
NEXT_PUBLIC_SITE_URL="https://greenpoly.com"

# 可选：统一使用看板 vb-metrics 的收集地址。设置后每条埋点会额外镜像一份
# 匿名信号（project + event + sessionId，无 PII）到看板；留空则不镜像。
# 本地联调：http://localhost:8787/api/collect
# NEXT_PUBLIC_METRICS_ENDPOINT=""

# Admin auth — 32+ random chars in production
AUTH_SECRET="local-development-only-not-for-production"

# Seed defaults (used only by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@greenpoly.com"
SEED_ADMIN_PASSWORD="changeme123"

# Optional: email notifications when an inquiry comes in
# RESEND_API_KEY=
# NOTIFICATION_EMAIL=sales@greenpoly.com
